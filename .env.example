# WarpDeck compose 环境变量（复制为 .env 后按需修改）。
# 安全默认（§20.5）：宿主机绑定默认为 127.0.0.1（loopback），只允许本机访问。
# 需要公网暴露时（配合 Proxy 页认证/allowlist）取消注释并设置：
#   WEB_HOST_BIND=0.0.0.0
#   SOCKS5_HOST_BIND=0.0.0.0
#   HTTP_HOST_BIND=0.0.0.0
WEB_HOST_PORT=9000
SOCKS5_HOST_PORT=11080
HTTP_HOST_PORT=18080
# 留空 = 首次启动自动生成 /var/lib/warpdeck/master.key（0600）。
WARPDECK_MASTER_KEY=
WARPDECK_LOG=info
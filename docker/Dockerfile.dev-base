# syntax=docker/dockerfile:1.7

# WarpDeck dev-base（计划 P2-012 / 设计 §23.3）。
#
# 固定开发镜像：只含运行时依赖，不构建产品二进制。
# 只有本文件、docker/*.sh、OS 包、WARP/GOST 安装逻辑变化才允许重建。
# 后端普通代码变化通过 bind mount Linux binary 后重启容器（§23.3）。
#
# 依赖下载：构建期经 docker/fetch-deps.sh 拉取（断点续传 + cache mount + SHA256
# 硬校验）；中国网络下 --build-arg DL_PROXY=socks5h://host.docker.internal:10808
# 走宿主代理。GOST/WARP 的 URL/SHA256/版本唯一来源 = crates/xtask/src/versions.json：
# 直接从 build context COPY 后用 jq 解析（与主 Dockerfile 同机制），不设默认值副本。
# 脚本入口：`cargo xtask dev-base`。

FROM ubuntu:24.04

ARG DL_PROXY=""

# ubuntu:24.04 官方镜像默认只启用 main/restricted，而 cloudflare-warp 依赖
# universe 组件（libwebkit2gtk-4.1-0 等）。先补充源配置再装基础工具。
# 注意：只缓存 /var/cache/apt（deb 包），不缓存 /var/lib/apt/lists——否则
# 缓存被清后 RUN 层 CACHED 会跳过 apt-get update，导致索引为空、依赖解析失败。
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    sed -i 's/^Components: main restricted$/Components: main restricted universe multiverse/' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg jq lsb-release dbus tini iproute2

COPY docker/install-warp.sh docker/install-gost.sh docker/fetch-deps.sh /usr/local/bin/

# versions.json 是 GOST/WARP 版本/URL/SHA256 的唯一来源；两个 RUN 都要消费，
# 故 jq 与该文件都留到最后一个 RUN 才清理。
COPY crates/xtask/src/versions.json /tmp/versions.json

# 与主 Dockerfile 同款模式：裸赋值列表（dash/bash 均保证从左到右求值）+
# 单独 export，避免同一句 export 内自引用在 dash 下取到空值。
RUN --mount=type=cache,target=/dl-cache,sharing=locked \
    WARP_DEB_URL="$(jq -r .warp.url /tmp/versions.json)" \
    WARP_DEB_SHA256="$(jq -r .warp.sha256 /tmp/versions.json)" \
    && export DL_PROXY WARP_DEB_URL WARP_DEB_SHA256 \
    && bash /usr/local/bin/fetch-deps.sh "${WARP_DEB_URL}" "${WARP_DEB_SHA256}" 60000000 "/dl-cache/${WARP_DEB_URL##*/}" \
    && cp "/dl-cache/${WARP_DEB_URL##*/}" /tmp/cloudflare-warp.deb \
    && bash /usr/local/bin/install-warp.sh /tmp/cloudflare-warp.deb

RUN --mount=type=cache,target=/dl-cache,sharing=locked \
    GOST_TARBALL_URL="$(jq -r .gost.url /tmp/versions.json)" \
    EXPECTED_GOST_SHA256="$(jq -r .gost.sha256 /tmp/versions.json)" \
    GOST_VERSION="$(jq -r .gost.version /tmp/versions.json)" \
    && export DL_PROXY EXPECTED_GOST_SHA256 GOST_VERSION \
    && bash /usr/local/bin/fetch-deps.sh "${GOST_TARBALL_URL}" "${EXPECTED_GOST_SHA256}" 9000000 "/dl-cache/${GOST_TARBALL_URL##*/}" \
    && bash /usr/local/bin/install-gost.sh amd64 "/dl-cache/${GOST_TARBALL_URL##*/}" \
    && useradd -m -s /bin/bash warp \
    && mkdir -p /var/lib/warpdeck /run/warpdeck \
    && chown warp:warp /var/lib/warpdeck /run/warpdeck \
    && rm -f /tmp/versions.json \
    && apt-get purge -y jq

USER warp

ENV WARPDECK_DATA_DIR=/var/lib/warpdeck
ENV WARPDECK_RUNTIME_DIR=/run/warpdeck

# 数据面运行需要：--device /dev/net/tun --cap-add NET_ADMIN（WARP 需建 tun 设备）。
# CMD 是组件探针（非入口，dev-base 不运行业务进程）；warp-cli status 在 daemon
# 未启动时输出错误文本但 exit 0——判别请用 cargo xtask smoke-dev-base。
CMD ["bash", "-c", "warp-cli --accept-tos status; gost -V; dbus-daemon --version"]

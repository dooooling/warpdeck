# 编译工具链镜像：在 Linux 环境内编译 warpdeck-server（x86_64-unknown-linux-gnu ELF）。
# 与运行镜像 warpdeck-dev-base:1 解耦：本镜像只负责编译，不含 warp/gost/dbus 运行时。
# rust:<ver>-bookworm = buildpack-deps:bookworm（自带 gcc/make/pkg-config + rustup；`cargo xtask in-container` 运行期动态探测 toolchain 目录，升级镜像无需改代码）。
#
# 用法：见 `cargo xtask in-container`（宿主 ~/.cargo/registry/cache 只读命中 +
# target 命名卷）。
#
# 关键约束（踩坑记录）：
# - 不要在此镜像内执行任何触发 rustup 网络检查的 RUN（rustup default / rustc
#   --version 都会 sync channel manifest，国内直连 static.rust-lang.org 卡死）。
# - 容器 cargo 的 CARGO_HOME=/usr/local/cargo（不是 /root/.cargo）。
# - crates-io 必须用 config.toml source replacement 切 aliyun；环境变量
#   CARGO_REGISTRIES_CRATES_IO_INDEX 对 crates-io 无效（cargo 文档仅支持
#   registry.index / source.<name>.registry），实测 cargo 会退回官方 index。
FROM rust:1.96

# 与宿主 ~/.cargo/config.toml 同款 source replacement：aliyun sparse 镜像。
RUN mkdir -p /usr/local/cargo \
    && printf '[source.crates-io]\nreplace-with = "aliyun"\n\n[source.aliyun]\nregistry = "sparse+https://mirrors.aliyun.com/crates.io-index/"\n' > /usr/local/cargo/config.toml

# 官方镜像为 minimal profile（无 clippy/rustfmt 组件）。构建期补装；国内网络经
# RUSTUP_PROXY 走代理（cargo xtask in-container --rebuild-image --proxy 自动注入），
# 直连可用则留空。组件装进 pinned toolchain，运行期完全离线。
ARG RUSTUP_PROXY=""
RUN if [ -n "${RUSTUP_PROXY}" ]; then export https_proxy="${RUSTUP_PROXY}" http_proxy="${RUSTUP_PROXY}"; fi \
    && rustup component add clippy rustfmt

ENV CARGO_TERM_COLOR=never \
    CARGO_INCREMENTAL=1 \
    RUSTUP_OFFLINE=1